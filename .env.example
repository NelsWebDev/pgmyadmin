# pgMyAdmin configuration. Copy to .env and edit.
# Real environment variables override values in this file.
# PGMA_ENV_FILE=/path/to/other.env   (use another file; empty value disables .env loading)

# ---- Servers (like PMA_HOST / PMA_PORT / PMA_VERBOSE) ----
# Comma-separated lists. A single PGMA_PORT applies to every host.
#PGMA_HOST=localhost
#PGMA_HOSTS=db1.example.com,db2.example.com
#PGMA_PORT=5432
#PGMA_PORTS=5432,5433
#PGMA_VERBOSE=Production
#PGMA_VERBOSES=Production,Staging
# Allow typing any host on the login page (like PMA_ARBITRARY).
# Default: true when no host is configured, otherwise false.
#PGMA_ARBITRARY=false

# ---- Authentication ----
# cookie: log in with a username/password form (default)
# config: always connect as PGMA_USER (single server only, no login screen!)
#PGMA_AUTH_TYPE=cookie
#PGMA_USER=postgres
#PGMA_PASSWORD=
# Defaults prefilled on the login form / used for connections
#PGMA_DATABASE=postgres
#PGMA_SSL=false
# Allow logging in with an empty password (default true)
#PGMA_ALLOW_NO_PASSWORD=true

# ---- Database access ----
# Only these databases are accessible (comma list, * and % wildcards)
#PGMA_ONLY_DB=app_*,analytics
# Hide matching databases from the list (regular expression, cosmetic only)
#PGMA_HIDE_DB=^(template0|template1)$

# ---- Limits ----
#PGMA_LOGIN_COOKIE_VALIDITY=1800   # idle session timeout, seconds
#PGMA_MAX_ROWS=50                  # default rows per page
#PGMA_MAX_SQL_ROWS=1000            # row cap for SQL console results
#PGMA_EXEC_TIME_LIMIT=0            # statement_timeout in seconds, 0 = none
#PGMA_UPLOAD_LIMIT=50M             # max import / request size

# ---- Web server ----
#PGMA_LISTEN_HOST=127.0.0.1
#PGMA_LISTEN_PORT=3000
#PGMA_TRUST_PROXY=false            # true, hop count, or express trust-proxy value
#PGMA_COOKIE_SECURE=false          # force the Secure flag on the session cookie
